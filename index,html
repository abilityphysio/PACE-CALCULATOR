    <!-- Range Clamp Notice Toast (Non-blocking inline status) -->
    <div
      id="status-banner"
      class="hidden rounded-xl bg-brand-50 border border-brand-200 px-3.5 py-2 text-xs font-medium text-brand-700 text-center"
    ></div>

  </main>

  <!-- Footer -->
  <footer class="w-full max-w-5xl mx-auto px-4 py-4 text-center">
    <p class="font-mono text-[11px] tracking-wider text-stone-400">
      PACE LANE &bull; offline ready &bull; no data leaves this device
    </p>
  </footer>

  <!-- Install as Android App Helper Modal -->
  <div
    id="install-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-stone-950/60 backdrop-blur-xs p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="install-modal-title"
  >
    <div class="bg-surface-card border border-surface-border rounded-3xl max-w-md w-full p-6 shadow-2xl flex flex-col gap-4">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-brand-600 flex items-center justify-center text-white shadow-md shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <circle cx="12" cy="13" r="8" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4l2.5 2.5M9 2h6" />
            </svg>
          </div>
          <div>
            <h2 id="install-modal-title" class="text-base font-extrabold text-stone-900">
              Install Pace Lane on Android
            </h2>
            <p class="text-xs text-stone-500">Runs full-screen & offline like a native app</p>
          </div>
        </div>
        <button
          id="close-modal-x"
          type="button"
          aria-label="Close install instructions"
          class="w-8 h-8 rounded-full bg-surface-well hover:bg-stone-200 text-stone-600 flex items-center justify-center cursor-pointer"
        >✕</button>
      </div>

      <!-- Native Prompt Trigger (shown automatically if browser supports beforeinstallprompt) -->
      <button
        id="native-install-trigger"
        type="button"
        class="hidden w-full py-3 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-md transition cursor-pointer"
      >
        Install App Now
      </button>

      <ol class="space-y-3 text-xs sm:text-sm text-stone-700 bg-surface-well p-4 rounded-2xl border border-surface-border">
        <li class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-full bg-brand-600 text-white font-mono text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">1</span>
          <span>Host this <code class="font-mono bg-white px-1.5 py-0.5 rounded text-stone-800">index.html</code> on <strong>GitHub Pages</strong> and open the <code class="font-mono text-brand-700">https://</code> link in <strong>Google Chrome</strong> on Android.</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-full bg-brand-600 text-white font-mono text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">2</span>
          <span>Tap the <strong>three dots (⋮)</strong> in the top-right corner of Chrome.</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-full bg-brand-600 text-white font-mono text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">3</span>
          <span>Tap <strong>Add to Home screen</strong> → <strong>Install</strong>. The Pace Lane icon will appear in your Android app drawer.</span>
        </li>
      </ol>

      <button
        id="close-modal-btn"
        type="button"
        class="w-full py-2.5 px-4 rounded-xl bg-stone-900 hover:bg-stone-800 text-white text-xs font-semibold tracking-wide uppercase cursor-pointer"
      >
        Got It
      </button>
    </div>
  </div>

  <!-- Application Logic & Offline Service Worker Registration -->
  <script>
    (function () {
      'use strict';

      // --- Constants & Preset Lists ---
      const MIN_DIST = 80;
      const MAX_DIST = 5000;
      const DISTANCE_PRESETS = [80, 100, 150, 200, 300, 400, 600, 800, 1000, 1200, 1600, 2000, 3000, 4000, 5000];
      const DURATION_MIN_PRESETS = [1, 2, 3, 4, 5, 6, 9, 12, 15, 20, 24, 30];

      // --- Application State ---
      // mode = which field is COMPUTED ('duration' | 'pace' | 'distance')
      const state = {
        mode: 'duration',
        distanceMeters: 5000, // 80m - 5000m
        paceMin: 5,           // 2 - 20 min/km
        paceSec: 15,          // 0 - 59 sec/km
        durMin: 26,           // 0 - 120 min
        durSec: 15            // 0 - 59 sec
      };

      // --- DOM References ---
      const modePills = document.querySelectorAll('.mode-pill');
      const cardHeaderBtns = document.querySelectorAll('.card-header-btn');
      const cards = {
        distance: document.getElementById('card-distance'),
        pace: document.getElementById('card-pace'),
        duration: document.getElementById('card-duration')
      };
      const dots = {
        distance: document.getElementById('dot-distance'),
        pace: document.getElementById('dot-pace'),
        duration: document.getElementById('dot-duration')
      };
      const tags = {
        distance: document.getElementById('tag-distance'),
        pace: document.getElementById('tag-pace'),
        duration: document.getElementById('tag-duration')
      };

      const distanceInput = document.getElementById('distance-input');
      const distanceSlider = document.getElementById('distance-slider');
      const distanceKmSub = document.getElementById('distance-km-sub');
      const distancePresetsEl = document.getElementById('distance-presets');

      const paceMinSelect = document.getElementById('pace-min-select');
      const paceSecSelect = document.getElementById('pace-sec-select');
      const paceSecChips = document.querySelectorAll('.pace-sec-chip');

      const durMinSelect = document.getElementById('dur-min-select');
      const durSecSelect = document.getElementById('dur-sec-select');
      const durationPresetsEl = document.getElementById('duration-presets');

      const summaryDistKm = document.getElementById('summary-dist-km');
      const summaryDistM = document.getElementById('summary-dist-m');
      const summaryPace = document.getElementById('summary-pace');
      const summaryTime = document.getElementById('summary-time');
      const summaryLap = document.getElementById('summary-lap');
      const summarySpeed = document.getElementById('summary-speed');
      const statusBanner = document.getElementById('status-banner');

      // --- Populate Select Options & Preset Chips ---
      function initControls() {
        // Pace Minutes (2 to 20, highlighting common 3-7)
        for (let m = 2; m <= 20; m++) {
          const opt = document.createElement('option');
          opt.value = m;
          opt.textContent = m;
          paceMinSelect.appendChild(opt);
        }

        // Pace Seconds (00 to 59 so computed paces display cleanly, quarters stand out)
        for (let s = 0; s < 60; s++) {
          const opt = document.createElement('option');
          opt.value = s;
          opt.textContent = String(s).padStart(2, '0');
          paceSecSelect.appendChild(opt);
        }

        // Duration Minutes (0 to 120)
        for (let m = 0; m <= 120; m++) {
          const opt = document.createElement('option');
          opt.value = m;
          opt.textContent = m;
          durMinSelect.appendChild(opt);
        }

        // Duration Seconds (00 to 59)
        for (let s = 0; s < 60; s++) {
          const opt = document.createElement('option');
          opt.value = s;
          opt.textContent = String(s).padStart(2, '0');
          durSecSelect.appendChild(opt);
        }

        // Distance Preset Chips
        DISTANCE_PRESETS.forEach((meters) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.dist = meters;
          btn.textContent = meters;
          btn.className = 'dist-preset-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-surface-well hover:bg-brand-100 text-stone-700 border border-surface-border cursor-pointer transition';
          btn.addEventListener('click', () => {
            if (state.mode === 'distance') {
              setMode('duration');
            }
            setDistance(meters);
          });
          distancePresetsEl.appendChild(btn);
        });

        // Duration Preset Chips
        DURATION_MIN_PRESETS.forEach((mins) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.durMin = mins;
          btn.textContent = `${mins}m`;
          btn.className = 'dur-preset-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-surface-well hover:bg-brand-100 text-stone-700 border border-surface-border cursor-pointer transition';
          btn.addEventListener('click', () => {
            if (state.mode === 'duration') {
              setMode('pace');
            }
            state.durMin = mins;
            state.durSec = 0;
            recalculate();
          });
          durationPresetsEl.appendChild(btn);
        });
      }

      // --- Formatting Helpers ---
      function pad2(n) {
        return String(Math.floor(Math.max(0, n))).padStart(2, '0');
      }

      function formatClock(totalSeconds) {
        const rounded = Math.max(0, Math.round(totalSeconds));
        const mins = Math.floor(rounded / 60);
        const secs = rounded % 60;
        return `${mins}:${pad2(secs)}`;
      }

      function formatLapSplit(secondsPer400m) {
        if (!isFinite(secondsPer400m) || secondsPer400m <= 0) return '0:00.0';
        const mins = Math.floor(secondsPer400m / 60);
        const rem = (secondsPer400m % 60).toFixed(1);
        const paddedRem = Number(rem) < 10 ? `0${rem}` : rem;
        return `${mins}:${paddedRem}`;
      }

      function showNotice(msg) {
        if (!msg) {
          statusBanner.classList.add('hidden');
          statusBanner.textContent = '';
          return;
        }
        statusBanner.textContent = msg;
        statusBanner.classList.remove('hidden');
      }

      // --- Core Math & State Sync ---
      function recalculate() {
        showNotice('');

        const distKm = state.distanceMeters / 1000;
        let totalPaceSec = state.paceMin * 60 + state.paceSec;
        let totalDurSec = state.durMin * 60 + state.durSec;

        if (state.mode === 'duration') {
          // Compute Duration from Distance & Pace
          totalDurSec = Math.round(distKm * totalPaceSec);
          state.durMin = Math.min(120, Math.floor(totalDurSec / 60));
          state.durSec = totalDurSec % 60;
        } else if (state.mode === 'pace') {
          // Compute Pace from Distance & Duration
          if (totalDurSec <= 0) {
            totalDurSec = 1;
            state.durSec = 1;
          }
          totalPaceSec = Math.round(totalDurSec / distKm);
          const clampedPaceSec = Math.max(120, Math.min(20 * 60 + 59, totalPaceSec));
          if (clampedPaceSec !== totalPaceSec) {
            showNotice(`Computed pace (${formatClock(totalPaceSec)}/km) adjusted to displayable range (2:00–20:59/km).`);
          }
          state.paceMin = Math.floor(clampedPaceSec / 60);
          state.paceSec = clampedPaceSec % 60;
          totalPaceSec = clampedPaceSec;
        } else if (state.mode === 'distance') {
          // Compute Distance from Pace & Duration
          if (totalPaceSec <= 0) {
            totalPaceSec = 300;
            state.paceMin = 5;
            state.paceSec = 0;
          }
          const rawMeters = Math.round((totalDurSec / totalPaceSec) * 1000);
          const clampedMeters = Math.max(MIN_DIST, Math.min(MAX_DIST, rawMeters));
          if (rawMeters < MIN_DIST || rawMeters > MAX_DIST) {
            showNotice(`Computed distance (${rawMeters}m) clamped to supported 80m–5000m range.`);
          }
          state.distanceMeters = clampedMeters;
        }

        render();
      }

      function render() {
        // 1. Update Mode Pills & Card Highlights
        modePills.forEach((pill) => {
          const isTarget = pill.dataset.mode === state.mode;
          const badge = pill.querySelector('.computed-badge');
          if (isTarget) {
            pill.classList.add('bg-brand-600', 'text-white', 'shadow-sm');
            pill.classList.remove('text-stone-600', 'hover:text-stone-900');
            badge.classList.remove('hidden');
          } else {
            pill.classList.remove('bg-brand-600', 'text-white', 'shadow-sm');
            pill.classList.add('text-stone-600', 'hover:text-stone-900');
            badge.classList.add('hidden');
          }
        });

        (['distance', 'pace', 'duration']).forEach((key) => {
          const isComputed = state.mode === key;
          const card = cards[key];
          const dot = dots[key];
          const tag = tags[key];

          if (isComputed) {
            card.classList.add('border-brand-500', 'bg-brand-50/40', 'ring-2', 'ring-brand-500/20');
            card.classList.remove('border-surface-border', 'bg-surface-card');
            dot.classList.remove('hidden');
            tag.textContent = 'COMPUTED';
            tag.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-brand-600 text-white tracking-wider';
          } else {
            card.classList.remove('border-brand-500', 'bg-brand-50/40', 'ring-2', 'ring-brand-500/20');
            card.classList.add('border-surface-border', 'bg-surface-card');
            dot.classList.add('hidden');
            tag.textContent = 'INPUT';
            tag.className = 'text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-stone-200/80 text-stone-600 tracking-wider';
          }
        });

        // 2. Sync Distance UI
        if (document.activeElement !== distanceInput) {
          distanceInput.value = state.distanceMeters;
        }
        distanceSlider.value = state.distanceMeters;
        const kmFormatted = (state.distanceMeters / 1000).toFixed(2);
        distanceKmSub.textContent = `${kmFormatted} km`;

        document.querySelectorAll('.dist-preset-chip').forEach((chip) => {
          const active = Number(chip.dataset.dist) === state.distanceMeters;
          chip.className = active
            ? 'dist-preset-chip px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-brand-600 text-white border border-brand-600 cursor-pointer transition'
            : 'dist-preset-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-surface-well hover:bg-brand-100 text-stone-700 border border-surface-border cursor-pointer transition';
        });

        // 3. Sync Pace UI
        paceMinSelect.value = state.paceMin;
        paceSecSelect.value = state.paceSec;

        paceSecChips.forEach((chip) => {
          const active = Number(chip.dataset.paceSec) === state.paceSec;
          chip.className = active
            ? 'pace-sec-chip py-1.5 rounded-lg text-xs font-mono font-bold bg-brand-600 text-white border border-brand-600 cursor-pointer transition'
            : 'pace-sec-chip py-1.5 rounded-lg text-xs font-mono font-semibold bg-surface-well hover:bg-brand-100 text-stone-700 border border-surface-border cursor-pointer transition';
        });

        // 4. Sync Duration UI
        durMinSelect.value = state.durMin;
        durSecSelect.value = state.durSec;

        document.querySelectorAll('.dur-preset-chip').forEach((chip) => {
          const active = Number(chip.dataset.durMin) === state.durMin && state.durSec === 0;
          chip.className = active
            ? 'dur-preset-chip px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-brand-600 text-white border border-brand-600 cursor-pointer transition'
            : 'dur-preset-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-surface-well hover:bg-brand-100 text-stone-700 border border-surface-border cursor-pointer transition';
        });

        // 5. Sync Live Bottom Summary Bar
        const totalPaceSec = state.paceMin * 60 + state.paceSec;
        const totalDurSec = state.durMin * 60 + state.durSec;
        const lap400Sec = totalPaceSec * 0.4;
        const speedKmh = totalPaceSec > 0 ? (3600 / totalPaceSec).toFixed(1) : '0.0';

        summaryDistKm.textContent = `${kmFormatted} km`;
        summaryDistM.textContent = `${state.distanceMeters} m`;
        summaryPace.textContent = `${state.paceMin}:${pad2(state.paceSec)}`;
        summaryTime.textContent = formatClock(totalDurSec);
        summaryLap.textContent = formatLapSplit(lap400Sec);
        summarySpeed.textContent = `${speedKmh} km/h`;
      }

      // --- Mutators ---
      function setMode(newMode) {
        if (!['distance', 'pace', 'duration'].includes(newMode)) return;
        state.mode = newMode;
        recalculate();
      }

      function setDistance(meters, switchFromAuto = true) {
        if (switchFromAuto && state.mode === 'distance') {
          state.mode = 'duration';
        }
        const clamped = Math.max(MIN_DIST, Math.min(MAX_DIST, Math.round(meters)));
        state.distanceMeters = clamped;
        recalculate();
      }

      function adjustPace(deltaSeconds) {
        if (state.mode === 'pace') {
          state.mode = 'duration';
        }
        let total = state.paceMin * 60 + state.paceSec + deltaSeconds;
        total = Math.max(120, Math.min(20 * 60 + 59, total));
        state.paceMin = Math.floor(total / 60);
        state.paceSec = total % 60;
        recalculate();
      }

      function adjustDuration(deltaSeconds) {
        if (state.mode === 'duration') {
          state.mode = 'pace';
        }
        let total = state.durMin * 60 + state.durSec + deltaSeconds;
        total = Math.max(1, Math.min(120 * 60 + 59, total));
        state.durMin = Math.floor(total / 60);
        state.durSec = total % 60;
        recalculate();
      }

      // --- Event Listeners ---
      modePills.forEach((pill) => {
        pill.addEventListener('click', () => setMode(pill.dataset.mode));
      });

      cardHeaderBtns.forEach((btn) => {
        btn.addEventListener('click', () => setMode(btn.dataset.mode));
      });

      // Distance inputs
      distanceInput.addEventListener('input', () => {
        const val = parseInt(distanceInput.value, 10);
        if (!isNaN(val)) {
          if (state.mode === 'distance') state.mode = 'duration';
          if (val >= MIN_DIST && val <= MAX_DIST) {
            state.distanceMeters = val;
            recalculate();
          }
        }
      });

      distanceInput.addEventListener('blur', () => {
        const val = parseInt(distanceInput.value, 10);
        setDistance(isNaN(val) ? MIN_DIST : val, false);
        distanceInput.value = state.distanceMeters;
      });

      distanceSlider.addEventListener('input', () => {
        setDistance(parseInt(distanceSlider.value, 10));
      });

      document.getElementById('dist-minus').addEventListener('click', () => {
        setDistance(state.distanceMeters - 10);
      });

      document.getElementById('dist-plus').addEventListener('click', () => {
        setDistance(state.distanceMeters + 10);
      });

      // Pace inputs
      paceMinSelect.addEventListener('change', () => {
        if (state.mode === 'pace') state.mode = 'duration';
        state.paceMin = parseInt(paceMinSelect.value, 10);
        recalculate();
      });

      paceSecSelect.addEventListener('change', () => {
        if (state.mode === 'pace') state.mode = 'duration';
        state.paceSec = parseInt(paceSecSelect.value, 10);
        recalculate();
      });

      document.getElementById('pace-min-minus').addEventListener('click', () => adjustPace(-60));
      document.getElementById('pace-min-plus').addEventListener('click', () => adjustPace(60));
      document.getElementById('pace-sec-minus').addEventListener('click', () => adjustPace(-5));
      document.getElementById('pace-sec-plus').addEventListener('click', () => adjustPace(5));

      paceSecChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          if (state.mode === 'pace') state.mode = 'duration';
          state.paceSec = parseInt(chip.dataset.paceSec, 10);
          recalculate();
        });
      });

      // Duration inputs
      durMinSelect.addEventListener('change', () => {
        if (state.mode === 'duration') state.mode = 'pace';
        state.durMin = parseInt(durMinSelect.value, 10);
        recalculate();
      });

      durSecSelect.addEventListener('change', () => {
        if (state.mode === 'duration') state.mode = 'pace';
        state.durSec = parseInt(durSecSelect.value, 10);
        recalculate();
      });

      document.getElementById('dur-min-minus').addEventListener('click', () => adjustDuration(-60));
      document.getElementById('dur-min-plus').addEventListener('click', () => adjustDuration(60));
      document.getElementById('dur-sec-minus').addEventListener('click', () => adjustDuration(-15));
      document.getElementById('dur-sec-plus').addEventListener('click', () => adjustDuration(15));

      // --- Install Modal & Native PWA Install Prompt ---
      const installBtn = document.getElementById('install-btn');
      const installModal = document.getElementById('install-modal');
      const closeModalX = document.getElementById('close-modal-x');
      const closeModalBtn = document.getElementById('close-modal-btn');
      const nativeInstallTrigger = document.getElementById('native-install-trigger');
      let deferredPrompt = null;

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        nativeInstallTrigger.classList.remove('hidden');
      });

      nativeInstallTrigger.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
        nativeInstallTrigger.classList.add('hidden');
        installModal.classList.add('hidden');
        installModal.classList.remove('flex');
      });

      function openInstallModal() {
        installModal.classList.remove('hidden');
        installModal.classList.add('flex');
      }

      function closeInstallModal() {
        installModal.classList.add('hidden');
        installModal.classList.remove('flex');
      }

      installBtn.addEventListener('click', openInstallModal);
      closeModalX.addEventListener('click', closeInstallModal);
      closeModalBtn.addEventListener('click', closeInstallModal);
      installModal.addEventListener('click', (e) => {
        if (e.target === installModal) closeInstallModal();
      });

      // --- Inline Blob Service Worker for Offline Caching on GitHub Pages ---
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        const swCode = `
          const CACHE_NAME = 'pace-lane-v1';
          self.addEventListener('install', (event) => {
            event.waitUntil(
              caches.open(CACHE_NAME).then((cache) => cache.addAll(['./']))
            );
            self.skipWaiting();
          });
          self.addEventListener('activate', (event) => {
            event.waitUntil(self.clients.claim());
          });
          self.addEventListener('fetch', (event) => {
            event.respondWith(
              caches.match(event.request).then((cached) => {
                return cached || fetch(event.request).then((response) => {
                  const copy = response.clone();
                  caches.open(CACHE_NAME).then((cache) => cache.put(event.request, copy));
                  return response;
                }).catch(() => cached);
              })
            );
          });
        `;
        try {
          const blob = new Blob([swCode], { type: 'application/javascript' });
          const swUrl = URL.createObjectURL(blob);
          navigator.serviceWorker.register(swUrl).catch(() => {});
        } catch (err) {
          // Graceful fallback if restricted by browser sandbox
        }
      }

      // --- Boot ---
      initControls();
      recalculate();
    })();
  </script>
